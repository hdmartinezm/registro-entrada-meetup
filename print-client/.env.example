# Configuración del Cliente de Impresión

# URL de la cola SQS (obtener después del deploy)
PRINT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/970512219824/registro-meetup-print-queue

# Nombre de la impresora (ejecuta 'lpstat -p' para ver las disponibles)
PRINTER_NAME=Ribetec_RT_420ME

# Región de AWS
AWS_REGION=us-east-1

# Intervalo de polling en milisegundos (opcional, default: 2000)
POLL_INTERVAL=2000
